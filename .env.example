# Copy to .env and fill in. Never commit .env.

# Google Cloud API key with "Places API (New)" enabled. Required for `discover`.
GOOGLE_PLACES_API_KEY=

# Optional separate key for the PageSpeed Insights API.
# If blank, GOOGLE_PLACES_API_KEY is used. PSI also works with no key at a low quota.
GOOGLE_PAGESPEED_API_KEY=

# Optional. Only needed when you pass --llm (or set llm.enabled: true in config.yaml).
ANTHROPIC_API_KEY=
